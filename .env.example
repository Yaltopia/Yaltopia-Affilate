# firebase | supabase | convex
NEXT_PUBLIC_DATA_PROVIDER=firebase
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase (primary) — public client config only
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin — server only, never NEXT_PUBLIC_
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Supabase (alternate)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Convex (alternate) — Better Auth
# NEXT_PUBLIC_DATA_PROVIDER=convex
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Convex dashboard env (not Next): BETTER_AUTH_SECRET, SITE_URL
# Optional social (Convex dashboard env):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
